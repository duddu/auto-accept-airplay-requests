    "sass-embedded": "^1.86.1",
    "sass-loader": "^16.0.5",
    "vue": "^3.5.13",
    "vuepress": "2.0.0-rc.20"
  },
  "overrides": {
    "esbuild": "$esbuild",
    "vuepress": "$vuepress"
